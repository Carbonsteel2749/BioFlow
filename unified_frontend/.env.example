# BioFlow 统一入口（unified_frontend）环境变量
#
# 全部可选。留空时按「当前页面主机名 + 默认端口」推导，
# 因此用服务器 IP 或域名访问时会自动指向同一台机器。

# 统一入口自身端口（dev / preview 都用它）
UNIFIED_FRONTEND_PORT=5180

# 文献知识库（ai-localbase：前端 + API 同源在 8080）
VITE_LITERATURE_UI_URL=
VITE_LITERATURE_HEALTH_URL=

# 数据分析（BioLLM：UI 5173，API 8000）
# 注意：API 8000 只监听 127.0.0.1，外部浏览器直连不到，
# 所以探活地址默认走 UI 的 Vite 代理 5173/api/health。
VITE_ANALYSIS_UI_URL=
VITE_ANALYSIS_HEALTH_URL=

# 论文撰写（article_writing：UI 与 API 都在 8765）
VITE_WRITING_UI_URL=
VITE_WRITING_HEALTH_URL=
