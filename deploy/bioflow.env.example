# Python APIs remain on loopback; expose the gateway through an HTTPS reverse proxy.
BIOFLOW_ANALYSIS_URL=http://127.0.0.1:8000
BIOFLOW_WRITING_URL=http://127.0.0.1:8765
BIOFLOW_LITERATURE_URL=http://127.0.0.1:8080
BIOFLOW_SECURE_COOKIE=1
BIOFLOW_ALLOW_REGISTRATION=1
# Use actual server paths; do not copy the Windows virtual environment.
BIOLLM_INPUT_ROOT=/srv/bioflow/BioLLM_RawDataAnalysis/runtime/incoming
BIOLLM_STATE_ROOT=/srv/bioflow/BioLLM_RawDataAnalysis/runtime
BIOLLM_WORKFLOW_PATH=/srv/bioflow/BioLLM_RawDataAnalysis/workflow/main.nf
ARTICLE_WRITING_ANALYSIS_ROOT=/srv/bioflow/BioLLM_RawDataAnalysis/runtime/outputs
# Fill the actual database, Nextflow and model-service configuration from the original deployment.
