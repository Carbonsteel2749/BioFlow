# ============================================================
# BioFlow · 文献知识库（Article_repository）本地配置模板
# 复制为 .env 后按需填写：cp .env.example .env
# .env 已被 .gitignore 排除，不会入库。
# ============================================================

# ---------- PubMed 抓取 ----------
# NCBI E-utilities API Key（可选）。留空则受无 key 限流（3 req/s）。
# 申请地址：https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# 每次增量抓取的检索式与条数（示例）
PUBMED_KEYWORDS=autism gut microbiome
PUBMED_RETMAX=20

# 增量更新周期（月）
INCREMENT_UPDATE_CYCLE_MONTH=1

# ---------- ai-localbase 向量库 ----------
# 向量库地址（前端与 API 同源）
AI_LOCALBASE_URL=http://127.0.0.1:8080

# 目标知识库：优先使用 ID；未设置则按名称匹配；都为空则取第一个知识库
AI_LOCALBASE_KB_ID=
AI_LOCALBASE_KB_NAME=

# ---------- 本地数据库 ----------
# 说明：SQLite 已停用，历史数据已迁移至 ai-localbase 向量库。
# 仅保留兼容用途，默认指向仓库内的 sqlite 文件（已被 .gitignore 排除）。
SQLITE_DB_FILE=./article_literature.sqlite3

# ---------- 机翻服务（检索查询翻译）----------
# 用于把中文检索问题转成英文检索式，见 scripts/mt_service.py
MT_PORT=8090
MT_MODEL=Helsinki-NLP/opus-mt-zh-en
MT_QUANTIZE=0
HF_ENDPOINT=https://hf-mirror.com
